# Auto detect text files and perform LF normalization
* text=auto

# Script files
*.sh text eol=lf

# Python files
*.py text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary

# Data files
*.csv text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Export-ignore files for archives
/.github export-ignore
/docs export-ignore
/tests export-ignore
/scripts export-ignore
